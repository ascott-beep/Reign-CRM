# Database (see docker-compose.yml for local Postgres, or point at any Postgres 15+ instance)
DATABASE_URL="postgresql://reign:reign_dev_password@localhost:5432/reign_crm?schema=public"
# Used only for `prisma migrate dev` shadow database when it can't be created automatically
SHADOW_DATABASE_URL="postgresql://reign:reign_dev_password@localhost:5432/reign_crm_shadow?schema=public"

# Auth.js
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
# Only set AUTH_URL if you need to force a specific canonical origin (e.g.
# behind a reverse proxy in production). Left unset in local development so
# Auth.js infers it from the incoming request (works across any dev port).
# AUTH_URL="https://crm.example.com"
AUTH_TRUST_HOST="true"

# Workspace defaults (seed data)
WORKSPACE_NAME="Reign Partners"
WORKSPACE_SLUG="reign-partners"
WORKSPACE_DEFAULT_CURRENCY="GBP"
WORKSPACE_DEFAULT_TIMEZONE="Europe/London"
# Brand accent used across the UI (design token). Reign Partners' exact brand
# colour could not be retrieved automatically (reign.partners was unreachable
# from the build environment's network policy) — this is a placeholder deep
# navy that reads well against the neutral palette. Change centrally here or
# in Settings > Workspace once you have the confirmed brand value.
WORKSPACE_BRAND_ACCENT="#1C2B4A"

# Seed data is opt-in outside development. Set to "true" to allow `db:seed`
# to run demo/fictional data against a non-development NODE_ENV.
ALLOW_SEED_IN_PRODUCTION="false"
# Demo login password for seeded users (Adam/Yagmur). Never reuse in production.
SEED_USER_PASSWORD="ChangeMe123!"

# File storage provider: "local" (default, stores under ./storage) or "s3"
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./storage"
# S3-compatible provider (required only when STORAGE_PROVIDER=s3)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

NODE_ENV="development"
