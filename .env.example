# Database (see docker-compose.yml for local Postgres, or point at any Postgres 15+ instance)
DATABASE_URL="postgresql://reign:reign_dev_password@localhost:5432/reign_crm?schema=public"
# Used only for `prisma migrate dev` shadow database when it can't be created automatically
SHADOW_DATABASE_URL="postgresql://reign:reign_dev_password@localhost:5432/reign_crm_shadow?schema=public"
# The direct (unpooled) connection Prisma Migrate uses instead of DATABASE_URL
# (see prisma/schema.prisma's directUrl) — Neon's Vercel integration sets this
# automatically in deployed environments. Locally, where there's no pooler,
# it's the same connection as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://reign:reign_dev_password@localhost:5432/reign_crm?schema=public"

# Auth.js
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
# Only set AUTH_URL if you need to force a specific canonical origin (e.g.
# behind a reverse proxy in production). Left unset in local development so
# Auth.js infers it from the incoming request (works across any dev port).
# AUTH_URL="https://crm.example.com"
AUTH_TRUST_HOST="true"

# Workspace defaults (seed data)
WORKSPACE_NAME="Reign Partners"
WORKSPACE_SLUG="reign-partners"
WORKSPACE_DEFAULT_CURRENCY="GBP"
WORKSPACE_DEFAULT_TIMEZONE="Europe/London"
# Brand accent used across the UI (design token). Best-effort visual match to
# the Reign Partners logo navy from a reference screenshot — confirm the
# exact hex code and adjust here (or in Settings > Workspace) once available.
WORKSPACE_BRAND_ACCENT="#101E33"

# Seed data is opt-in outside development. Set to "true" to allow `db:seed`
# to run demo/fictional data against a non-development NODE_ENV.
ALLOW_SEED_IN_PRODUCTION="false"
# Demo login password for seeded users (Adam/Yagmur). Never reuse in production.
SEED_USER_PASSWORD="ChangeMe123!"

# File storage provider: "local" (default, stores under ./storage) or "s3"
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./storage"
# S3-compatible provider (required only when STORAGE_PROVIDER=s3). For
# Cloudflare R2: S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com",
# S3_REGION="auto".
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# Optional SSO (section 9.2) — the Google/Microsoft buttons on the login page
# only appear once their full set of env vars below is present. The same app
# registrations are reused for email/calendar sync (Round 2 section 7) with
# broader, incrementally-consented scopes — no separate app needed.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# AZURE_AD_CLIENT_ID=""
# AZURE_AD_CLIENT_SECRET=""
# AZURE_AD_TENANT_ID=""

# Optional transactional email (invite / password-reset links). Without this,
# links are logged to the server console instead of emailed.
# RESEND_API_KEY=""

# Optional AI research agent (Round 2 section 5) — Claude with web search.
# Without this, the Intelligence watchlist sweep and "Research now" are
# disabled. Get a key at https://console.anthropic.com.
# ANTHROPIC_API_KEY=""

# Optional email/calendar sync (Round 2 section 7). Required once
# GOOGLE_CLIENT_ID/AZURE_AD_CLIENT_ID above are set and a user tries to
# connect their mailbox — encrypts the OAuth tokens at rest.
# Generate with: openssl rand -base64 32
# MAILBOX_TOKEN_ENCRYPTION_KEY=""
# Optional: a Google Cloud Pub/Sub topic (projects/<project>/topics/<topic>)
# granting publish rights to gmail-api-push@system.gserviceaccount.com, for
# real-time Gmail push instead of relying only on the 5-minute poll.
# GMAIL_PUBSUB_TOPIC=""

# Absolute origin used to build links in emails. Vercel sets VERCEL_URL
# automatically in deployed environments; only set this to override it (e.g.
# a custom domain) or for local testing against a non-default port.
# NEXT_PUBLIC_APP_URL="https://crm.reign.partners"

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when
# triggering /api/cron/* routes (purge-archived, update-exchange-rates,
# intelligence-sweep, mailbox-sync). Required in production; generate with
# `openssl rand -hex 32`.
# CRON_SECRET=""

NODE_ENV="development"
