// =============================================================================
// WORKSPACE, USERS & AUTH
// =============================================================================

model Workspace {
  id                            String             @id @default(cuid())
  name                          String
  slug                          String             @unique
  defaultCurrency               String             @default("GBP") @db.VarChar(3)
  defaultTimezone               String             @default("Europe/London")
  brandAccent                   String             @default("#1C2B4A")
  staleThresholds               Json               @default("{\"personDays\":60,\"priorityOrgDays\":60,\"opportunityDays\":14,\"candidateProcessDays\":7}")
  opportunityStageProbabilities Json?
  /// GBP value of 1 unit of each currency code, e.g. {"GBP":1,"USD":0.79}.
  /// Manually maintained unless updateRatesAutomatically is on — used to
  /// roll monetary report totals into a single selected display currency.
  exchangeRatesToGbp            Json?
  updateRatesAutomatically      Boolean            @default(false)
  exchangeRatesUpdatedAt        DateTime?
  /// Round 2 section 5/6 — Intelligence AI research agent settings, surfaced in Settings > Connections.
  intelligenceSweepEnabled      Boolean            @default(false)
  intelligenceSweepHourUtc      Int                @default(6)
  /// Empty = every IntelligenceType is in scope.
  intelligenceSignalTypes       IntelligenceType[] @default([])
  /// Round 2 section 8 "Admins can switch Ask Atlas off in Settings."
  askAtlasEnabled               Boolean            @default(true)
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  users                     User[]
  organizations             Organization[]
  organizationRelationships OrganizationRelationship[]
  people                    Person[]
  opportunities             Opportunity[]
  mandates                  Mandate[]
  candidateProcesses        CandidateProcess[]
  intelligenceItems         IntelligenceItem[]
  intelligenceRuns          IntelligenceRun[]
  activities                Activity[]
  tasks                     Task[]
  documents                 Document[]
  tags                      Tag[]
  offLimitsRestrictions     OffLimitsRestriction[]
  savedViews                SavedView[]
  customFieldDefinitions    CustomFieldDefinition[]
  auditLogs                 AuditLog[]
  sectors                   Sector[]
  investorStrategies        InvestorStrategy[]
  ownershipTypes            OwnershipType[]
  practiceAreas             PracticeArea[]
  functionalSpecialisms     FunctionalSpecialism[]
  importJobs                ImportJob[]
  askAtlasQueries           AskAtlasQuery[]
}

model User {
  id                      String    @id @default(cuid())
  workspaceId             String
  workspace               Workspace @relation(fields: [workspaceId], references: [id])
  firstName               String
  lastName                String
  email                   String
  passwordHash            String?
  role                    UserRole  @default(STANDARD)
  active                  Boolean   @default(true)
  avatarUrl               String?
  timezone                String    @default("Europe/London")
  notificationPreferences Json      @default("{}")
  lastLoginAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  ownedOrganizations      Organization[]                 @relation("OrganizationOwner")
  createdOrganizations    Organization[]                 @relation("OrganizationCreatedBy")
  archivedOrganizations   Organization[]                 @relation("OrganizationArchivedBy")
  createdOrgRelationships OrganizationRelationship[]     @relation("OrgRelationshipCreatedBy")
  ownedPeople             Person[]                       @relation("PersonOwner")
  createdPeople           Person[]                       @relation("PersonCreatedBy")
  archivedPeople          Person[]                       @relation("PersonArchivedBy")
  qualifiedCandidates     CandidateProfile[]             @relation("CandidateQualifiedBy")
  ownedOpportunities      Opportunity[]                  @relation("OpportunityOwner")
  createdOpportunities    Opportunity[]                  @relation("OpportunityCreatedBy")
  archivedOpportunities   Opportunity[]                  @relation("OpportunityArchivedBy")
  opportunityStageChanges OpportunityStageHistory[]      @relation("OppStageChangedBy")
  ownedMandates           Mandate[]                      @relation("MandateOwner")
  createdMandates         Mandate[]                      @relation("MandateCreatedBy")
  archivedMandates        Mandate[]                      @relation("MandateArchivedBy")
  assignedMandates        MandateAssignedUser[]
  mandateStageChanges     MandateStatusHistory[]         @relation("MandateStatusChangedBy")
  ownedCandidateProcesses CandidateProcess[]             @relation("ProcessOwner")
  addedCandidateProcesses CandidateProcess[]             @relation("ProcessAddedBy")
  processStageChanges     CandidateProcessStageHistory[] @relation("ProcessStageChangedBy")
  createdInterviews       Interview[]                    @relation("InterviewCreatedBy")
  interviewParticipations InterviewInternalParticipant[]
  createdOffers           Offer[]                        @relation("OfferCreatedBy")
  createdPlacements       Placement[]                    @relation("PlacementCreatedBy")
  ownedIntelligence       IntelligenceItem[]             @relation("IntelligenceOwner")
  createdIntelligence     IntelligenceItem[]             @relation("IntelligenceCreatedBy")
  verifiedIntelligence    IntelligenceItem[]             @relation("IntelligenceVerifiedBy")
  createdActivities       Activity[]                     @relation("ActivityCreatedBy")
  assignedActivities      Activity[]                     @relation("ActivityAssignedOwner")
  assignedTasks           Task[]                         @relation("TaskAssignedUser")
  createdTasks            Task[]                         @relation("TaskCreatedBy")
  uploadedDocuments       Document[]                     @relation("DocumentUploadedBy")
  createdOffLimits        OffLimitsRestriction[]         @relation("OffLimitsCreatedBy")
  savedViews              SavedView[]                    @relation("SavedViewOwner")
  auditLogEntries         AuditLog[]                     @relation("AuditActor")
  notifications           InAppNotification[]
  importJobs              ImportJob[]                    @relation("ImportCreatedBy")
  passwordTokens          PasswordToken[]
  mailboxConnections      MailboxConnection[]
  neverSyncAddresses      NeverSyncAddress[]
  askAtlasQueries         AskAtlasQuery[]

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

enum PasswordTokenPurpose {
  INVITE
  RESET
}

/// One-time links for invite (set a password) and forgot-password (reset) emails.
model PasswordToken {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String               @unique
  purpose   PasswordTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId])
}

// =============================================================================
// ROUND 2 SECTION 7 — EMAIL AND CALENDAR SYNC
// =============================================================================

enum MailProvider {
  MICROSOFT
  GOOGLE
}

enum MailboxConnectionStatus {
  ACTIVE
  ERROR
  DISCONNECTED
}

/// One user's own mailbox/calendar connection (Microsoft Graph or Gmail+Google
/// Calendar), reusing the same app registration as sign-in (section 9.2) with
/// broader, incrementally-consented scopes. Tokens are encrypted at rest
/// (lib/mailbox-crypto.ts) — never stored or logged in plain text.
model MailboxConnection {
  id                         String                  @id @default(cuid())
  userId                     String
  user                       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider                   MailProvider
  emailAddress               String
  accessTokenEncrypted       String
  refreshTokenEncrypted      String?
  tokenExpiresAt             DateTime?
  emailSyncEnabled           Boolean                 @default(true)
  calendarSyncEnabled        Boolean                 @default(true)
  status                     MailboxConnectionStatus @default(ACTIVE)
  lastErrorMessage           String?
  lastEmailSyncAt            DateTime?
  lastCalendarSyncAt         DateTime?
  emailSyncCursor            String?
  calendarSyncCursor         String?
  graphSubscriptionId        String?
  graphSubscriptionExpiresAt DateTime?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

/// Section 7 "Each user has a 'never sync' list" — addresses this user's
/// sync should always skip, even if they match a Person in Atlas.
model NeverSyncAddress {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailAddress String
  createdAt    DateTime @default(now())

  @@unique([userId, emailAddress])
}

// =============================================================================
// ROUND 2 SECTION 8 — ASK ATLAS
// =============================================================================

/// Section 8 "Log every question." — one row per question asked, read-only feature so there's nothing else to audit here.
model AskAtlasQuery {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  question      String
  answer        String
  usedWebSearch Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

// =============================================================================
// EDITABLE TAXONOMIES / LOOKUP TABLES
// =============================================================================

model InvestorStrategy {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  name         String
  active       Boolean   @default(true)
  displayOrder Int       @default(0)

  organizations OrganizationInvestorStrategy[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model OwnershipType {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  name         String
  active       Boolean   @default(true)
  displayOrder Int       @default(0)

  organizations Organization[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Sector {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  name         String
  active       Boolean   @default(true)
  displayOrder Int       @default(0)
  parentId     String?
  parent       Sector?   @relation("SectorHierarchy", fields: [parentId], references: [id])
  children     Sector[]  @relation("SectorHierarchy")

  organizations       OrganizationSector[]
  candidateExperience CandidateSectorExperience[]

  @@unique([workspaceId, parentId, name])
  @@index([workspaceId])
}

model PracticeArea {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  name         String
  colorHex     String?
  active       Boolean   @default(true)
  displayOrder Int       @default(0)

  specialisms         FunctionalSpecialism[]
  employmentHistories EmploymentHistory[]
  candidateProfiles   CandidateProfilePracticeArea[]
  opportunities       Opportunity[]
  mandates            Mandate[]
  people              PersonPracticeArea[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model FunctionalSpecialism {
  id             String        @id @default(cuid())
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id])
  name           String
  active         Boolean       @default(true)
  displayOrder   Int           @default(0)
  practiceAreaId String?
  practiceArea   PracticeArea? @relation(fields: [practiceAreaId], references: [id])

  employmentHistories EmploymentHistorySpecialism[]
  candidateProfiles   CandidateProfileSpecialism[]
  opportunities       OpportunitySpecialism[]
  mandates            MandateSpecialism[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// =============================================================================
// ORGANIZATIONS
// =============================================================================

model Organization {
  id                       String             @id @default(cuid())
  workspaceId              String
  workspace                Workspace          @relation(fields: [workspaceId], references: [id])
  name                     String
  normalizedName           String
  type                     OrganizationType
  status                   OrganizationStatus @default(RESEARCH)
  website                  String?
  normalizedWebsiteDomain  String?
  linkedinUrl              String?
  hqCity                   String?
  hqRegion                 String?
  hqCountryCode            String?            @db.VarChar(2)
  countriesOfOperation     String[]
  ownershipTypeId          String?
  ownershipType            OwnershipType?     @relation(fields: [ownershipTypeId], references: [id])
  employeeCountMin         Int?
  employeeCountMax         Int?
  employeeCountExact       Int?
  revenueAmount            Decimal?           @db.Decimal(16, 2)
  revenueCurrency          String?            @db.VarChar(3)
  workingLanguages         String[]
  description              String?
  internalSummary          String?
  accountPriority          AccountPriority    @default(UNSCORED)
  priorityScore            Int?
  priorityScoreFlags       Json?
  priorityScoreExplanation String?
  relationshipOwnerId      String?
  relationshipOwner        User?              @relation("OrganizationOwner", fields: [relationshipOwnerId], references: [id])
  source                   String?
  sourceUrl                String?
  lastResearchedAt         DateTime?
  lastVerifiedAt           DateTime?

  // Fund-only extension fields
  aumAmount                      Decimal? @db.Decimal(18, 2)
  aumCurrency                    String?  @db.VarChar(3)
  typicalMinEquityChequeAmount   Decimal? @db.Decimal(16, 2)
  typicalMinEquityChequeCurrency String?  @db.VarChar(3)
  typicalMaxEquityChequeAmount   Decimal? @db.Decimal(16, 2)
  typicalMaxEquityChequeCurrency String?  @db.VarChar(3)
  typicalMinCompanySize          Int?
  typicalMaxCompanySize          Int?
  fundVintageOrCurrentFundName   String?
  fundNotes                      String?

  // Portfolio-company-only extension fields
  portfolioClassification    PortfolioClassification?
  businessModelSummary       String?
  investmentThesisSummary    String?
  valueCreationThemes        String[]
  acquisitionStrategySummary String?
  likelyExitWindow           String?
  financeTeamSummary         String?
  hiringProcessSummary       String?
  agencyUsageSummary         String?
  investmentStageOverride    InvestmentStage?

  createdById   String
  createdBy     User      @relation("OrganizationCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  archivedAt    DateTime?
  archivedById  String?
  archivedBy    User?     @relation("OrganizationArchivedBy", fields: [archivedById], references: [id])
  archiveReason String?

  relationshipsAsSource        OrganizationRelationship[]      @relation("OrgRelSource")
  relationshipsAsTarget        OrganizationRelationship[]      @relation("OrgRelTarget")
  investorStrategies           OrganizationInvestorStrategy[]
  sectors                      OrganizationSector[]
  personAssociations           PersonOrganizationAssociation[]
  employmentHistories          EmploymentHistory[]
  employmentHistoryInvestorFor EmploymentHistoryInvestor[]
  opportunitiesAsHiringOrg     Opportunity[]                   @relation("OpportunityHiringOrganization")
  opportunitiesAsRelatedFund   OpportunityFund[]
  mandatesAsHiringOrg          Mandate[]                       @relation("MandateHiringOrganization")
  mandatesAsRelatedFund        MandateFund[]
  intelligenceItems            IntelligenceItem[]              @relation("IntelligenceOrganization")
  intelligenceAsRelatedFund    IntelligenceItemFund[]
  intelligenceRuns             IntelligenceRun[]
  activities                   ActivityOrganization[]
  tasks                        TaskOrganization[]
  documents                    DocumentOrganization[]
  tags                         TagOnOrganization[]
  offLimitsRestrictions        OffLimitsRestriction[]
  placements                   Placement[]
  customFieldValues            CustomFieldValue[]              @relation("CustomFieldValueOrganization")
  people                       Person[]

  @@index([workspaceId, type])
  @@index([workspaceId, status])
  @@index([normalizedWebsiteDomain])
  @@index([normalizedName])
}

model OrganizationInvestorStrategy {
  id             String           @id @default(cuid())
  organizationId String
