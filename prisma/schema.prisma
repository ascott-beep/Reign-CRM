model Task {
  id                String             @id @default(cuid())
  workspaceId       String
  workspace         Workspace          @relation(fields: [workspaceId], references: [id])
  title             String
  description       String?
  type              TaskType           @default(OTHER)
  status            TaskStatus         @default(TODO)
  priority          TaskPriority       @default(NORMAL)
  assignedUserId    String
  assignedUser      User               @relation("TaskAssignedUser", fields: [assignedUserId], references: [id])
  createdById       String
  createdBy         User               @relation("TaskCreatedBy", fields: [createdById], references: [id])
  dueDate           DateTime
  dueTime           String?
  reminderAt        DateTime?
  completedAt       DateTime?
  completionNote    String?
  relatedRecordType RelatedRecordType?
  relatedRecordId   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  archivedAt        DateTime?

  people                 TaskPerson[]
  organizations          TaskOrganization[]
  opportunities          TaskOpportunity[]
  mandates               TaskMandate[]
  candidateProcesses     TaskCandidateProcess[]
  intelligenceItems      TaskIntelligenceItem[]
  activityFollowUpFor    Activity?              @relation("ActivityFollowUpTask")
  opportunityPrimaryFor  Opportunity?           @relation("OpportunityPrimaryNextTask")
  mandatePrimaryFor      Mandate?               @relation("MandatePrimaryNextTask")
  processPrimaryFor      CandidateProcess?      @relation("ProcessPrimaryNextTask")
  intelligencePrimaryFor IntelligenceItem?      @relation("IntelligencePrimaryNextTask")
  notifications          InAppNotification[]

  @@index([workspaceId, status])
  @@index([assignedUserId, dueDate])
}

model TaskPerson {
  id       String @id @default(cuid())
  taskId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([taskId, personId])
}

model TaskOrganization {
