model Offer {
  id                        String           @id @default(cuid())
  candidateProcessId        String
  candidateProcess          CandidateProcess @relation(fields: [candidateProcessId], references: [id], onDelete: Cascade)
  status                    OfferStatus      @default(PLANNED)
  offerDate                 DateTime?
  expiryDate                DateTime?
  baseAmount                Decimal?         @db.Decimal(14, 2)
  baseCurrency              String?          @db.VarChar(3)
  bonusAmount               Decimal?         @db.Decimal(14, 2)
  bonusPercentage           Decimal?         @db.Decimal(5, 2)
  signOnAmount              Decimal?         @db.Decimal(14, 2)
  signOnCurrency            String?          @db.VarChar(3)
  equityDetails             String?
  dayRateAmount             Decimal?         @db.Decimal(10, 2)
  dayRateCurrency           String?          @db.VarChar(3)
  proposedStartDate         DateTime?
  noticeConsiderations      String?
  candidateResponseDate     DateTime?
  declineOrWithdrawalReason String?
  notes                     String?
  createdById               String
  createdBy                 User             @relation("OfferCreatedBy", fields: [createdById], references: [id])
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  acceptedForPlacement Placement?

  @@index([candidateProcessId])
}

model Placement {
  id                        String           @id @default(cuid())
  candidateProcessId        String           @unique
  candidateProcess          CandidateProcess @relation(fields: [candidateProcessId], references: [id])
  mandateId                 String
  mandate                   Mandate          @relation(fields: [mandateId], references: [id])
  candidatePersonId         String
  candidatePerson           Person           @relation(fields: [candidatePersonId], references: [id])
  hiringOrganizationId      String
  hiringOrganization        Organization     @relation(fields: [hiringOrganizationId], references: [id])
  acceptedOfferId           String?          @unique
  acceptedOffer             Offer?           @relation(fields: [acceptedOfferId], references: [id])
  placementDate             DateTime
  startDate                 DateTime?
  employmentType            EmploymentType
  agreedBaseAmount          Decimal?         @db.Decimal(14, 2)
  agreedBaseCurrency        String?          @db.VarChar(3)
  agreedTotalCashAmount     Decimal?         @db.Decimal(14, 2)
  agreedTotalCashCurrency   String?          @db.VarChar(3)
  agreedDayRateAmount       Decimal?         @db.Decimal(10, 2)
  agreedDayRateCurrency     String?          @db.VarChar(3)
  feeAmount                 Decimal?         @db.Decimal(14, 2)
  feeCurrency               String?          @db.VarChar(3)
  guaranteeEndDate          DateTime?
  status                    PlacementStatus  @default(PLANNED_START)
  fallThroughOrLeaverReason String?
  createdById               String
  createdBy                 User             @relation("PlacementCreatedBy", fields: [createdById], references: [id])
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  @@index([mandateId])
  @@index([candidatePersonId])
}

// =============================================================================
// INTELLIGENCE
// =============================================================================

model IntelligenceItem {
  id                     String                      @id @default(cuid())
  workspaceId            String
  workspace              Workspace                   @relation(fields: [workspaceId], references: [id])
  title                  String
  organizationId         String
  organization           Organization                @relation("IntelligenceOrganization", fields: [organizationId], references: [id])
  type                   IntelligenceType
  details                String?
  sourcePersonId         String?
  sourcePerson           Person?                     @relation("IntelligenceSourcePerson", fields: [sourcePersonId], references: [id])
  sourceActivityId       String?
  sourceActivity         Activity?                   @relation("ActivitySourcedIntelligence", fields: [sourceActivityId], references: [id])
  sourceUrl              String?
  dateReceived           DateTime                    @default(now())
  confidence             IntelligenceConfidence      @default(UNVERIFIED)
  commercialRelevance    CommercialRelevance         @default(NONE)
  confidentiality        IntelligenceConfidentiality @default(INTERNAL)
  verifiedById           String?
  verifiedBy             User?                       @relation("IntelligenceVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt             DateTime?
  ownerId                String
  owner                  User                        @relation("IntelligenceOwner", fields: [ownerId], references: [id])
  followUpRequired       Boolean                     @default(false)
  primaryNextTaskId      String?                     @unique
  primaryNextTask        Task?                       @relation("IntelligencePrimaryNextTask", fields: [primaryNextTaskId], references: [id])
  convertedOpportunityId String?                     @unique
  convertedOpportunity   Opportunity?                @relation("IntelligenceConvertedOpportunity", fields: [convertedOpportunityId], references: [id])
  createdById            String
  createdBy              User                        @relation("IntelligenceCreatedBy", fields: [createdById], references: [id])
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  archivedAt             DateTime?

  /// Round 2 section 5 — agent-found signals start PENDING_REVIEW in the
  /// review queue; hand-logged signals (the pre-existing "Log signal" flow)
  /// default straight to ACCEPTED so nothing already in the CRM changes.
  reviewState   IntelligenceReviewState    @default(ACCEPTED)
  dismissReason IntelligenceDismissReason?
  dismissedAt   DateTime?
  runId         String?
  run           IntelligenceRun?           @relation(fields: [runId], references: [id])

  relatedFunds IntelligenceItemFund[]
  activities   ActivityIntelligenceItem[]
  tasks        TaskIntelligenceItem[]
  documents    DocumentIntelligenceItem[]
  tags         TagOnIntelligenceItem[]
  sources      IntelligenceSource[]

  @@index([workspaceId, type])
  @@index([organizationId])
  @@index([workspaceId, reviewState])
}

enum IntelligenceReviewState {
  PENDING_REVIEW
  ACCEPTED
  DISMISSED
}

enum IntelligenceDismissReason {
  NOT_RELEVANT
  WRONG_COMPANY
  ALREADY_KNEW
}

/// Round 2 section 5 — "merge duplicates... into one signal with several sources."
model IntelligenceSource {
  id                 String           @id @default(cuid())
  intelligenceItemId String
  intelligenceItem   IntelligenceItem @relation(fields: [intelligenceItemId], references: [id], onDelete: Cascade)
  url                String
  title              String?
  createdAt          DateTime         @default(now())

  @@index([intelligenceItemId])
}

enum IntelligenceRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// Round 2 section 5 — "Log every run, its sources and its cost."
model IntelligenceRun {
  id             String                @id @default(cuid())
  workspaceId    String
  workspace      Workspace             @relation(fields: [workspaceId], references: [id])
  organizationId String?
  organization   Organization?         @relation(fields: [organizationId], references: [id])
  provider       String
  status         IntelligenceRunStatus @default(RUNNING)
  signalsFound   Int                   @default(0)
  costUsd        Decimal?              @db.Decimal(10, 4)
  errorMessage   String?
  startedAt      DateTime              @default(now())
  finishedAt     DateTime?

  signals IntelligenceItem[]

  @@index([workspaceId, startedAt])
  @@index([organizationId])
}

model IntelligenceItemFund {
  id                 String           @id @default(cuid())
  intelligenceItemId String
  intelligenceItem   IntelligenceItem @relation(fields: [intelligenceItemId], references: [id], onDelete: Cascade)
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id])

  @@unique([intelligenceItemId, organizationId])
}

// =============================================================================
// ACTIVITIES
// =============================================================================

model Activity {
  id               String            @id @default(cuid())
  workspaceId      String
  workspace        Workspace         @relation(fields: [workspaceId], references: [id])
  type             ActivityType
  direction        ActivityDirection @default(NOT_APPLICABLE)
  outcome          ActivityOutcome?
  subject          String?
  occurredAt       DateTime          @default(now())
  durationMinutes  Int?
  summary          String?
  fullNotes        String?
  createdById      String
  createdBy        User              @relation("ActivityCreatedBy", fields: [createdById], references: [id])
  assignedOwnerId  String
  assignedOwner    User              @relation("ActivityAssignedOwner", fields: [assignedOwnerId], references: [id])
  followUpRequired Boolean           @default(false)
  followUpTaskId   String?           @unique
  followUpTask     Task?             @relation("ActivityFollowUpTask", fields: [followUpTaskId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  /// Section 7 "Private flag per email: other users see 'Email with <name>'
  /// without the content." Only meaningful for type=EMAIL; the owner
  /// (assignedOwnerId) or creator can toggle it.
  private           Boolean @default(false)
  /// The provider's Message-ID, for idempotent re-sync and reply-threading. Unset for hand-logged activities.
  externalMessageId String? @unique

  people                       ActivityPerson[]
  organizations                ActivityOrganization[]
  opportunities                ActivityOpportunity[]
  mandates                     ActivityMandate[]
  candidateProcesses           ActivityCandidateProcess[]
  intelligenceItems            ActivityIntelligenceItem[]
  sourcedOpportunity           Opportunity[]              @relation("ActivitySourcedOpportunity")
  sourcedIntelligence          IntelligenceItem[]         @relation("ActivitySourcedIntelligence")
  relatedPersonBacklink        Person[]                   @relation("ActivityRelatedPerson")
  sourcedOpportunityBacklink   Opportunity?               @relation("ActivitySourcedOpportunityBacklink", fields: [sourcedOpportunityBacklinkId], references: [id])
  sourcedOpportunityBacklinkId String?

  @@index([workspaceId, occurredAt])
  @@index([assignedOwnerId])
}

model ActivityPerson {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  personId   String
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([activityId, personId])
}

model ActivityOrganization {
  id             String       @id @default(cuid())
