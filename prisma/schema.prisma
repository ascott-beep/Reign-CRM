  updatedAt          DateTime              @updatedAt

  @@unique([definitionId, organizationId])
  @@unique([definitionId, personId])
  @@unique([definitionId, candidateProfileId])
  @@unique([definitionId, opportunityId])
  @@unique([definitionId, mandateId])
  @@index([definitionId])
}

