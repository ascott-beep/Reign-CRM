  createdBy          User             @relation("InterviewCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  internalParticipants InterviewInternalParticipant[]
  externalParticipants InterviewExternalParticipant[]

  @@index([candidateProcessId])
}

model InterviewInternalParticipant {
