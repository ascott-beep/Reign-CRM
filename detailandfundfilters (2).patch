+
+export function RelatedOrgCard({
+  id,
+  name,
+  type,
+  subtitle,
+  investmentStatus,
+  date,
+}: {
+  id: string;
+  name: string;
+  type: string;
+  subtitle?: string | null;
+  investmentStatus?: string | null;
+  date?: Date | null;
+}) {
+  return (
+    <Link href={`/organisations/${id}`} className="block">
